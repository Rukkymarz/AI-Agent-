# AICOMPANY-OS environment. `scripts/bootstrap.sh` generates .env from this file with random secrets.
# NEVER commit .env. High-value keys live in ./secrets/* (Docker secrets) or Vault — not here.

# ---------------------------------------------------------------- deployment
DOMAIN=aicos.example.com
ACME_EMAIL=ops@example.com
AICOS_ENV=production            # development | test | staging | production
AICOS_VERSION=0.1.0
AICOS_TENANT_ID=default
ENCRYPTION_AT_REST=false        # set true once host disks are LUKS/dm-crypt or cloud-KMS encrypted

# ---------------------------------------------------------------- models
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_PULL="qwen3:14b deepseek-r1:14b deepseek-coder-v2:16b mistral:7b llama3.1:8b gemma3:4b bge-m3 nomic-embed-text"

# ---------------------------------------------------------------- generated by bootstrap (CHANGE_ME placeholders)
REDIS_PASSWORD=CHANGE_ME
PG_KEYCLOAK_PASSWORD=CHANGE_ME
PG_N8N_PASSWORD=CHANGE_ME
PG_LANGFUSE_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
OPENWEBUI_OIDC_SECRET=CHANGE_ME
N8N_OIDC_SECRET=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_SIGNING_KEY=CHANGE_ME
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_OTEL_AUTH=
SEARXNG_SECRET=CHANGE_ME
PGADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- vault (after scripts/vault-init)
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SKIP_VERIFY=false

# ---------------------------------------------------------------- image pins (replace with @sha256 digests for prod)
TRAEFIK_VERSION=v3.1
PGVECTOR_VERSION=pg16
REDIS_VERSION=7.4-alpine
KEYCLOAK_VERSION=26.0
VAULT_VERSION=1.18
OLLAMA_VERSION=0.5.7
OPENWEBUI_VERSION=v0.5.20
N8N_VERSION=1.80.0
LANGFUSE_VERSION=2
OTEL_VERSION=0.115.0
PROMETHEUS_VERSION=v2.55.1
GRAFANA_VERSION=11.3.0

# ---------------------------------------------------------------- local development only
# AICOS_ENV=development
# AICOS_AUTH_MODE=dev            # dev tokens: "Bearer dev:<user>:<Role,Role>:<mfa 0|1>"
# AICOS_LLM_PROVIDER=echo
# AICOS_EMBEDDING_PROVIDER=hashing
