<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ subject }}</title>
<style>
  body,table,td{margin:0;padding:0}
  img{border:0;outline:none;text-decoration:none;display:block}
  a{color:{{ brand.primary_color }}}
  .wrapper{width:100%;background:{{ brand.background_color }}}
  .container{width:600px;max-width:600px}
  .card{background:#ffffff;border-radius:10px}
  .btn a{display:inline-block;padding:14px 28px;border-radius:8px;background:{{ brand.primary_color }};color:#ffffff !important;
         font-weight:600;text-decoration:none;font-family:{{ brand.font_stack | safe }}}
  .muted{color:#6b7280}
  @media only screen and (max-width:620px){
    .container{width:100% !important}
    .px{padding-left:20px !important;padding-right:20px !important}
    .h1{font-size:22px !important;line-height:28px !important}
    .btn a{display:block !important;text-align:center}
  }
  @media (prefers-color-scheme: dark){
    .card{background:#111827 !important}
    .text{color:#e5e7eb !important}
    .muted{color:#9ca3af !important}
  }
</style>
<!--[if mso]><style>.btn a{padding:0 !important}</style><![endif]-->
</head>
<body style="margin:0;padding:0;background:{{ brand.background_color }}">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all">{% block preheader %}{% endblock %}&#8199;&#65279;&#847;</div>
<table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr><td align="center" style="padding:24px 12px">
    <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0">
      {% if brand.logo_url %}
      <tr><td class="px" style="padding:0 32px 16px 32px">
        <img src="{{ brand.logo_url }}" width="140" alt="{{ brand.company_name }}" style="max-width:140px;height:auto">
      </td></tr>
      {% endif %}
      <tr><td class="card px" style="padding:32px;border-radius:10px;background:#ffffff">
        <div class="text" style="font-family:{{ brand.font_stack }};font-size:16px;line-height:26px;color:#111827">
          {% block body %}{% endblock %}
        </div>
        {% block cta %}{% if cta_url %}
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 8px 0"><tr>
          <td class="btn" align="center" bgcolor="{{ brand.primary_color }}" style="border-radius:8px">
            <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" href="{{ cta_url }}" style="height:48px;v-text-anchor:middle;width:260px" arcsize="17%" fillcolor="{{ brand.primary_color }}" stroke="f"><center style="color:#ffffff;font-family:Arial;font-size:16px;font-weight:bold">{{ cta_label }}</center></v:roundrect><![endif]-->
            <!--[if !mso]><!--><a href="{{ cta_url }}" target="_blank" rel="noopener">{{ cta_label }}</a><!--<![endif]-->
          </td></tr></table>
        {% endif %}{% endblock %}
        <div class="text" style="font-family:{{ brand.font_stack }};font-size:16px;line-height:26px;color:#111827;margin-top:24px">
          Best regards,<br>
          <strong>{{ consultant }}</strong>{% if consultant_title %}<br><span class="muted">{{ consultant_title }}</span>{% endif %}<br>
          <span class="muted">{{ brand.company_name }}{% if brand.phone %} · {{ brand.phone }}{% endif %}</span>
        </div>
      </td></tr>
      <tr><td class="px" style="padding:20px 32px;font-family:{{ brand.font_stack }};font-size:12px;line-height:18px" align="center">
        <span class="muted">
          You're receiving this because {{ business_name }} is publicly listed as a business in {{ city or "your area" }}.
          {{ brand.company_name }} · {{ brand.physical_address }}<br>
          <a href="{{ unsubscribe_url }}" style="color:#6b7280">Unsubscribe</a> — one click, no further emails.
        </span>
      </td></tr>
    </table>
  </td></tr>
</table>
{% if tracking_pixel_url %}<img src="{{ tracking_pixel_url }}" width="1" height="1" alt="" style="display:block;width:1px;height:1px;border:0">{% endif %}
</body>
</html>
